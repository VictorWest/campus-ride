# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string — update user/password/db name to match your local setup
DATABASE_URL="postgresql://postgres:password@localhost:5432/campusride?schema=public"

# Any long random string. Used to sign/verify JWTs — do not share or commit.
JWT_SECRET="replace-with-a-long-random-string"

PORT=3000
